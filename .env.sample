# Tavily Api Key 
TAVILY_API_KEY=my_tavily_api_key

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=energy-seihr

# Data Source URLs — Tavily searches these directly
DATA_NATIONAL_GRID=https://www.neso.energy/data-portal/historic-generation-mix
DATA_CARBON_INTENSITY_API=https://carbon-intensity.github.io/api-definitions/
DATA_DEFRA_PM25=https://uk-air.defra.gov.uk/data/pcm-data
DATA_NHS_FINGERTIPS=https://fingertips.phe.org.uk/profile/public-health-outcomes-framework

# Optional: comma-separated Tavily scope. Defaults to the DATA_* URLs above.
TAVILY_ALLOWED_URLS=https://www.neso.energy/data-portal/historic-generation-mix,https://carbon-intensity.github.io/api-definitions/,https://uk-air.defra.gov.uk/data/pcm-data,https://fingertips.phe.org.uk/profile/public-health-outcomes-framework

# Backtest Period
BACKTEST_START=2021-01-01
BACKTEST_SPLIT=2023-04-01
BACKTEST_END=2024-12-31

# Simulation Defaults
DEFAULT_REGION=UK_Yorkshire
DEFAULT_SIMULATION_YEARS=5
